PORT=5000

# MongoDB Atlas → Connect → Drivers. Add the database name ("portfolio") before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Comma-separated list of frontend origins allowed by CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173,https://your-site.vercel.app

# Optional: email notification on new contact messages.
# Render's free tier blocks SMTP ports 25/465/587, so use Brevo on port 2525.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
# A sender address verified in Brevo
MAIL_FROM=ashmits004@gmail.com
MAIL_TO=ashmits004@gmail.com

# Only needed off Render (Render provides RENDER_EXTERNAL_URL automatically)
# KEEP_ALIVE_URL=https://your-api.example.com
